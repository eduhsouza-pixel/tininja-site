# Apache da Locaweb. O workflow locaweb.yml publica este arquivo junto com o
# site; não edite direto no servidor, o próximo deploy sobrescreve.
#
# Regras herdadas do Ofertas do Ninja, que rodou nesta mesma hospedagem e
# validou cada uma em produção (ofertas-ninja, public/.htaccess).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Domínio do Ofertas do Ninja (encerrado) e o temporário da Locaweb servem
  # esta mesma pasta: mandar tudo para a home do tininja.net.
  # 302 até conferir em produção; depois vira 301 (301 errado fica cacheado
  # no navegador e no X-Cache da Locaweb, sem como limpar).
  RewriteCond %{HTTP_HOST} (^|\.)ofertasdoninja\.com\.br$ [NC,OR]
  RewriteCond %{HTTP_HOST} \.hospedagemdesites\.ws$ [NC]
  RewriteRule ^ https://tininja.net/ [R=302,L]

  # www -> apex já em https, numa volta só. Vem antes da regra de HTTPS.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Força HTTPS. O TLS termina no nginx da Locaweb, na frente do Apache:
  # `%{HTTPS} off` sozinho entra em loop. Só redireciona quando os quatro
  # sinais dizem "não é https".
  RewriteCond %{HTTPS} !=on
  RewriteCond %{SERVER_PORT} !=443
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
  RewriteCond %{HTTP:X-Forwarded-SSL} !=on [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Turma Fundadora encerrada em 10/11/2026: links antigos vão para a página de
  # vendas, com a query (UTMs) preservada. 302 até conferir em produção.
  RewriteRule ^fundadora(/.*)?$ https://tininja.net/lp/fundamentos-de-rede/ [R=302,L]
</IfModule>

<IfModule mod_headers.c>
  # O nginx da Locaweb sobrescreve o Cache-Control de imagem, CSS e JS com um
  # ano. Ao trocar um arquivo desses, troque também o nome (ou ponha ?v=N na
  # referência), senão quem já visitou continua vendo o antigo.
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # HSTS curto de propósito: se algo der errado no HTTPS, o navegador esquece
  # em 5 minutos. Depois de uns dias sem problema, subir para 31536000 (1 ano).
  # includeSubDomains só depois de conferir que todo subdomínio (alunos.tininja.net
  # inclusive) responde em HTTPS; preload por último.
  Header always set Strict-Transport-Security "max-age=300"
  # clipboard-write fica liberado: os botões "Copiar" dependem dele.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Mesmo efeito do X-Frame-Options, no formato atual.
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  # CSP só em observação (Report-Only): não bloqueia nada, só avisa no console do
  # navegador. Lista o que o site carrega hoje: Meta Pixel nas LPs (script em
  # connect.facebook.net, envio para www.facebook.com), vídeo do YouTube em modo
  # nocookie e capas em i.ytimg.com, formulário do e-book no Apps Script (que
  # redireciona para script.googleusercontent.com), checkout da Hotmart, scripts e
  # estilos inline e os onerror das capas ('unsafe-inline'), e o email-decode do
  # Cloudflare em /cdn-cgi/ ('self'). Sem report-uri: não há endpoint para receber.
  # Antes de virar Content-Security-Policy de verdade, conferir dias de console
  # limpo nas LPs com o Pixel ligado: uma origem esquecida derruba o Pixel.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com https://www.facebook.com; font-src 'self'; media-src 'self'; connect-src 'self' https://www.facebook.com https://connect.facebook.net https://script.google.com https://script.googleusercontent.com; frame-src https://www.youtube-nocookie.com; form-action 'self' https://pay.hotmart.com https://script.google.com https://script.googleusercontent.com; base-uri 'self'; object-src 'none'"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/xml application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# Controle do FTP-Deploy-Action: fica no servidor, mas não é para o visitante.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
ErrorDocument 404 /404.html
