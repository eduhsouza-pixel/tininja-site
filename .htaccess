# Apache da Locaweb. O workflow locaweb.yml publica este arquivo junto com o
# site; não edite direto no servidor, o próximo deploy sobrescreve.
#
# Regras herdadas do Ofertas do Ninja, que rodou nesta mesma hospedagem e
# validou cada uma em produção (ofertas-ninja, public/.htaccess).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Domínio do Ofertas do Ninja (encerrado) e o temporário da Locaweb servem
  # esta mesma pasta: mandar tudo para a home do tininja.net.
  # 302 até conferir em produção; depois vira 301 (301 errado fica cacheado
  # no navegador e no X-Cache da Locaweb, sem como limpar).
  RewriteCond %{HTTP_HOST} (^|\.)ofertasdoninja\.com\.br$ [NC,OR]
  RewriteCond %{HTTP_HOST} \.hospedagemdesites\.ws$ [NC]
  RewriteRule ^ https://tininja.net/ [R=302,L]

  # www -> apex já em https, numa volta só. Vem antes da regra de HTTPS.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Força HTTPS. O TLS termina no nginx da Locaweb, na frente do Apache:
  # `%{HTTPS} off` sozinho entra em loop. Só redireciona quando os quatro
  # sinais dizem "não é https".
  RewriteCond %{HTTPS} !=on
  RewriteCond %{SERVER_PORT} !=443
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
  RewriteCond %{HTTP:X-Forwarded-SSL} !=on [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # O nginx da Locaweb sobrescreve o Cache-Control de imagem, CSS e JS com um
  # ano. Ao trocar um arquivo desses, troque também o nome (ou ponha ?v=N na
  # referência), senão quem já visitou continua vendo o antigo.
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/xml application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# Controle do FTP-Deploy-Action: fica no servidor, mas não é para o visitante.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
ErrorDocument 404 /404.html
